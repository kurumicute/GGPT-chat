# Flask
FLASK_SECRET_KEY=replace_with_a_long_random_value
TRAFFIC_SALT=replace_with_another_random_value
SESSION_COOKIE_SECURE=false
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=false
SESSION_LIFETIME_HOURS=12
TRUST_PROXY_COUNT=1
TRUSTED_HOSTS=chat.kurumicute.com,localhost,127.0.0.1
# 前後端同網域時留空；若分開部署，填入完整 Origin 並以逗號分隔
ALLOWED_ORIGINS=
# 單機可使用 memory://；多程序或多台主機建議使用 redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_NAME=chat_db

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_TTS_MODEL=tts-1

# Google 登入（不使用時留空）
GOOGLE_CLIENT_ID=

# 管理員，格式：帳號:密碼，多組以逗號分隔
ADMIN_ACCOUNTS=ggpt_owner:replace_with_a_unique_long_password

# 使用限制與上傳設定
USER_TOKEN_QUOTA=0
MAX_UPLOAD_MB=50
IMAGE_MAX_DIMENSION=2048
IMAGE_WEBP_QUALITY=82
GLOBAL_CHAT_MAX_LENGTH=500
GLOBAL_CHAT_HISTORY_LIMIT=50
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=32
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
CHAT_MESSAGE_MAX_LENGTH=20000
CHAT_MAX_ATTACHMENTS=8
OPENAI_MAX_OUTPUT_TOKENS=16000
